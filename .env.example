# ── LLM API keys ─────────────────────────────────────────────
# OpenAI (ChatGPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (Claude) — https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Perplexity — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# ── Search API (pick one) ────────────────────────────────────
# SerpAPI — https://serpapi.com/  (Bing Web Search v7 was retired in Aug 2025;
# SerpAPI's bing/google engines are the recommended replacement)
SERPAPI_API_KEY=...

# ── Runtime options ──────────────────────────────────────────
# "mock" runs everything against canned responses (no API cost). "live" hits real APIs.
AEO_MODE=mock

# Disk-cache TTL for LLM responses, in hours
AEO_CACHE_TTL_HOURS=24
